# ==============================================================================
# RECHERCHE V1 — MASTER PRODUCTION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Node Environment: 'development', 'test', 'staging', 'production'
NODE_ENV=production

# Server HTTP Port
PORT=4000

# Global REST API Prefix
API_PREFIX=api/v1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
# Database URL with PostGIS extension enabled
DATABASE_URL="postgresql://recherche_user:REPLACE_WITH_SECURE_PASSWORD@localhost:5432/recherche_db?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY (REQUIRED - STARTUP FAILS IF ABSENT)
# ------------------------------------------------------------------------------
# Access Token Secret (Min 32 characters, Cryptographically secure)
JWT_ACCESS_SECRET=REPLACE_WITH_MIN_32_CHAR_CRYPTO_SECURE_SECRET
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token Secret (Min 32 characters, Cryptographically secure)
JWT_REFRESH_SECRET=REPLACE_WITH_MIN_32_CHAR_CRYPTO_SECURE_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CORS & DOMAIN SECURITY
# ------------------------------------------------------------------------------
# Allowed Frontend Origins (Comma separated for multiple domains)
CORS_ORIGIN="https://recherche.cm,https://app.recherche.cm"

# ------------------------------------------------------------------------------
# 5. ORANGE MONEY PAYMENT GATEWAY (#150# USSD - CAMEROON / AFRICA)
# ------------------------------------------------------------------------------
# Orange Money Production API Credentials (UNDEFINED - EXTERNAL ACTION REQUIRED)
ORANGE_MONEY_BASE_URL="https://api.orange.com/orange-money-webpay/cm/v1"
ORANGE_MONEY_CLIENT_ID="UNDEFINED_REQUIRES_ORANGE_MERCHANT_ACCOUNT"
ORANGE_MONEY_CLIENT_SECRET="UNDEFINED_REQUIRES_ORANGE_MERCHANT_ACCOUNT"
ORANGE_MONEY_MERCHANT_KEY="UNDEFINED_REQUIRES_ORANGE_MERCHANT_ACCOUNT"

# Webhook Authentication Secret Key
ORANGE_MONEY_WEBHOOK_SECRET="UNDEFINED_REQUIRES_ORANGE_MERCHANT_ACCOUNT"

# ------------------------------------------------------------------------------
# 6. MTN MOBILE MONEY PAYMENT GATEWAY (*126# USSD - CAMEROON / AFRICA)
# ------------------------------------------------------------------------------
# MTN MoMo Production API Credentials (UNDEFINED - EXTERNAL ACTION REQUIRED)
MTN_MOMO_BASE_URL="https://proxy.momoapi.mtn.com/collection/v1_0"
MTN_MOMO_API_USER="UNDEFINED_REQUIRES_MTN_DEVELOPER_ACCOUNT"
MTN_MOMO_API_KEY="UNDEFINED_REQUIRES_MTN_DEVELOPER_ACCOUNT"
MTN_MOMO_PRIMARY_KEY="UNDEFINED_REQUIRES_MTN_DEVELOPER_ACCOUNT"

# Webhook Authentication Secret Key
MTN_MOMO_WEBHOOK_SECRET="UNDEFINED_REQUIRES_MTN_DEVELOPER_ACCOUNT"

# ------------------------------------------------------------------------------
# 7. GOOGLE MAPS API (CLIENT MAP INTEGRATION)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API Key (UNDEFINED - EXTERNAL ACTION REQUIRED)
GOOGLE_MAPS_API_KEY="UNDEFINED_REQUIRES_GOOGLE_MAPS_KEY"

# ------------------------------------------------------------------------------
# 8. STORAGE & FILE ATTACHMENTS
# ------------------------------------------------------------------------------
# S3 / Object Storage Configuration Placeholder
STORAGE_PROVIDER="local"
STORAGE_BUCKET_NAME="recherche-attachments-prod"

# ------------------------------------------------------------------------------
# 9. RATE LIMITING & ANTI-ABUSE
# ------------------------------------------------------------------------------
# Rate limit window in milliseconds (Default: 60000ms = 1 minute)
THROTTLE_TTL=60000
# Maximum requests per IP window
THROTTLE_LIMIT=100
